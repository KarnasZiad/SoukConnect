{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    // Type-checks against the contracts sources, so neither needs a prior build.
    "customConditions": ["@soukconnect/source"],
    "noEmit": true
  },
  "include": ["src", "test", "*.config.ts"]
}
