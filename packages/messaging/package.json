{
  "name": "@soukconnect/messaging",
  "version": "0.1.0",
  "private": true,
  "description": "RabbitMQ topology, confirmed publishing, consumers with delayed retries and dead letters, transactional outbox and inbox",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@soukconnect/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "@soukconnect/source": "./src/postgres.ts",
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./mongo": {
      "@soukconnect/source": "./src/mongo.ts",
      "types": "./dist/mongo.d.ts",
      "default": "./dist/mongo.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@soukconnect/contracts": "workspace:*",
    "amqplib": "^2.2.0"
  },
  "peerDependencies": {
    "mongodb": "^7.7.0",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^11.14.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/rabbitmq": "^11.14.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "mongodb": "^7.7.0",
    "postgres": "^3.4.9",
    "testcontainers": "^11.14.0",
    "vitest": "^4.1.12"
  }
}
