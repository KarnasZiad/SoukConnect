{
  "name": "@soukconnect/catalog",
  "version": "0.1.0",
  "private": true,
  "description": "Catalog service: shops, products with per-category attributes, stock reservations of the order saga, faceted search",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@soukconnect/source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "search:reindex": "tsx --conditions=@soukconnect/source --env-file-if-exists=../../.env src/cli/reindex.ts"
  },
  "dependencies": {
    "@soukconnect/contracts": "workspace:*",
    "@soukconnect/messaging": "workspace:*",
    "@soukconnect/service-kit": "workspace:*",
    "fastify": "^5.12.7",
    "meilisearch": "^0.62.0",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^11.14.0",
    "@testcontainers/rabbitmq": "^11.14.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
