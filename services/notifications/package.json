{
  "name": "@soukconnect/notifications",
  "version": "0.1.0",
  "private": true,
  "description": "Notifications service: buyer-seller conversations, real-time order tracking over Socket.io, in-app notifications and e-mails",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@soukconnect/source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@soukconnect/contracts": "workspace:*",
    "@soukconnect/messaging": "workspace:*",
    "@soukconnect/service-kit": "workspace:*",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^11.14.0",
    "@testcontainers/rabbitmq": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "socket.io-client": "^4.8.3",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
