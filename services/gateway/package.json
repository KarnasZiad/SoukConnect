{
  "name": "@soukconnect/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API gateway: accounts, server-side sessions, carts, routing to the services with internal tokens, aggregated OpenAPI",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@soukconnect/source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "keys:generate": "tsx --conditions=@soukconnect/source src/cli/generate-keys.ts",
    "account:create": "tsx --conditions=@soukconnect/source --env-file-if-exists=../../.env src/cli/create-account.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/reply-from": "^12.7.1",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@soukconnect/contracts": "workspace:*",
    "@soukconnect/service-kit": "workspace:*",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
