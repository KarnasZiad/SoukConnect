# Settings of the services run with pnpm dev against docker compose up.
# Copy to .env, never commit it. Each service reads only the variables it needs.

# Meilisearch master key (catalog only). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MEILI_MASTER_KEY=local-development-master-key-change-me

# Stripe test mode: https://dashboard.stripe.com/test/apikeys (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Connection strings of the local infrastructure
GATEWAY_DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
ORDERS_DATABASE_URL=postgresql://orders:orders@localhost:5432/orders
PAYMENTS_DATABASE_URL=postgresql://payments:payments@localhost:5432/payments
CATALOG_MONGODB_URL=mongodb://localhost:27017/catalog?directConnection=true
NOTIFICATIONS_MONGODB_URL=mongodb://localhost:27017/notifications?directConnection=true
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://souk:souk@localhost:5672
MEILISEARCH_URL=http://localhost:7700
SMTP_URL=smtp://localhost:1025

# The local stack is served over plain HTTP.
COOKIE_SECURE=false
